<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%= listing.title %></h3>
        </div>

        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing-image">
            <div class="card-body">
                <!-- <h5 class="card-title"><b><%= listing.title %></b></h5> -->
                <h6 class="card-text"></h6>
                <p class="card-text">
                    <%= listing.description %> <br>
                    &#8377;<%= listing.price %>/night <br>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>
        </div>
        <br>

        <div class="btns col-6 offset-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn action-btn">Edit</a>
        
            <form action="/listings/<%= listing._id %>/?_method=DELETE" method="post">
                <button class="btn btn-dark action-btn">Delete</button>
            </form>
        </div>

        <div class="col-8 offset-3 mb-3">
            <br>
            <h4>Leave a Review</h4>
            <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="mb-3 mt-3 needs-validation">
                <div>
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]">
                </div>
                <div>
                    <label for="comment" class="form-label">Comments</label>
                    <textarea rows="5" cols="30" id="comment" name="review[comment]" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review.</div>
                </div>
                <br>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        </div>
    </div>

</body>


